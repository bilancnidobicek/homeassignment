{
  "name": "swiss",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=ui",
    "test:api": "playwright test --project=api",
    "test:smoke": "playwright test --grep @smoke",
    "test:sanity": "playwright test --grep @sanity",
    "test:regression": "playwright test --grep @regression",
    "test:security": "playwright test --grep @security",
    "test:edge": "playwright test --grep @edge",
    "test:failed": "playwright test --last-failed",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:ui-mode": "playwright test --ui",
    "report": "playwright show-report",
    "allure:generate": "npx allure generate allure-results -o allure-report --clean",
    "allure:open": "npx allure open allure-report",
    "allure:serve": "npx allure serve allure-results",
    "allure:report": "playwright test; npm run allure:generate && npm run allure:open",
    "lint": "eslint . --ext .ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "allure-commandline": "^2.46.1",
    "allure-js-commons": "^3.12.2",
    "allure-playwright": "^3.12.2",
    "dotenv": "^18.0.3",
    "eslint": "^10.11.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
